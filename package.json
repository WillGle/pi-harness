{
  "name": "@will/pi-harness",
  "version": "1.0.0",
  "description": "Pi-native planning and goal harness",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillGle/pi-harness.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "acp"
  ],
  "bin": {
    "pi-harness": "bin/pi-harness.mjs",
    "pi-harness-web": "bin/pi-harness-web.mjs"
  },
  "files": [
    ".env.example",
    ".pi/agents/research.md",
    ".pi/agents/scout.md",
    ".pi/agents/worker.md",
    ".pi/subagents.json",
    "LICENSE",
    "README.md",
    "bin/",
    "extensions/",
    "future-work.md",
    "lib/",
    "packages/pi-harness-acp/",
    "scripts/bootstrap.mjs",
    "scripts/verify-skills.mjs",
    "skills/ask-user/SKILL.md",
    "skills/architecture-diagram/SKILL.md",
    "skills/architecture-diagram/assets/badge_overlap_audit.py",
    "skills/architecture-diagram/assets/template.drawio",
    "skills/architecture-diagram/references/readability.md",
    "skills/architecture-diagram/references/xml.md",
    "skills/caveman/SKILL.md",
    "skills/pi-coordinator/SKILL.md",
    "skills/ponytail/SKILL.md",
    "skills/project-scouting/SKILL.md",
    "skills/project-scouting/references/agents/scout-subagent.md",
    "skills/project-scouting/references/setup.md",
    "skills/project-scouting/scripts/scout.py",
    "skills/skill-hub/SKILL.md",
    "skills/skills.lock.json",
    "target-architecture.md"
  ],
  "scripts": {
    "build": "node --experimental-strip-types --check extensions/pi-harness.ts",
    "test": "node --test test/state.test.mjs test/coordinator.test.mjs test/skills.test.mjs test/web.test.mjs test/memory.test.mjs test/precise-edit.test.mjs test/code-intel.test.mjs",
    "test:integration": "node --test test/integration.test.mjs test/acp-acceptance.test.mjs test/pi-rpc-integration.test.mjs test/pi-plan-lifecycle.test.mjs test/zed-smoke.test.mjs test/disposable-install.test.mjs",
    "test:all": "npm run build && npm run test && npm run test:integration",
    "verify:skills": "node scripts/verify-skills.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node bin/pi-harness.mjs doctor"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "dependencies": {
    "@tintinweb/pi-subagents": "0.19.0",
    "typebox": "1.3.7"
  },
  "pi": {
    "extensions": [
      "node_modules/@tintinweb/pi-subagents/dist/index.js",
      "extensions"
    ],
    "skills": [
      "skills"
    ]
  }
}
