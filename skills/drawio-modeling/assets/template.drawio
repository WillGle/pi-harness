<mxfile host="app.diagrams.net">
  <diagram id="model" name="Model">
    <mxGraphModel grid="0" page="0" pageWidth="900" pageHeight="550" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Model name — scope" style="text;html=1;fontColor=#222222;fontSize=15;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="840" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="example" value="Replace with an evidenced model element" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#222222;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="250" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
